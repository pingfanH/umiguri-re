{
  "name": "open-umiguri",
  "version": "2.0.1",
  "description": "UMIGURI 反混淆重构工程: 模块化宿主层(Tauri 2) + 模块化游戏本体",
  "type": "module",
  "private": true,
  "scripts": {
    "deobf": "node tools/deobfuscate-fixed.mjs ../game_main.original.js dist/game_main.deobf.js",
    "build:host": "node build/bundle-host.mjs",
    "build:game": "node build/assemble-game.mjs && node build/bundle-game.mjs",
    "build": "npm run build:host && npm run build:game",
    "assemble:game": "node build/assemble-game.mjs",
    "check": "node build/check.mjs && node build/contract-check.mjs && node build/freevar-check.mjs",
    "extract:game": "node tools/split-game.mjs",
    "analyze:game": "node tools/analyze-bundle.mjs",
    "analyze:props": "node tools/analyze-props.mjs"
  },
  "devDependencies": {
    "@babel/generator": "^7.24.0",
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@babel/types": "^7.24.0",
    "esbuild": "^0.23.0",
    "three": "^0.137.0"
  }
}
