{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UMIGURI",
  "version": "2.0.1",
  "identifier": "jp.inonote.umiguri",
  "build": {
    "beforeDevCommand": "npm run build:esm:dev && node tools/patch-ios.mjs && touch src-tauri/src/lib.rs",
    "beforeBuildCommand": "npm run build:esm && node tools/patch-ios.mjs && touch src-tauri/src/lib.rs",
    "frontendDist": "../dist/www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "UMIGURI",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../dist/game_data/": "game_data/"
    }
  }
}
