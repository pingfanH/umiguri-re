Meta:
	Version	1
	
	Lang	ja
	Title	極上だ
	Desc	ゲージが上昇しない
	Desc	1010000点達成で
	Desc	ゲーム終了時にゲージがMAXになる
	
	Lang	en
	Title	Marvelous
	Desc	The gauge doesn't increase.
	Desc	When score is achieved 1,010,000,
	Desc	the gauge fill up.
	
	
	Attr	BManiac
	Indicator	IDBoost	INBoost

OnJudge:
	Boost	IDBoost	Mul	0
	
OnFinish:
	If	Score	=	1010000
		Boost	INBoost	Add	250000
	ClearIf
